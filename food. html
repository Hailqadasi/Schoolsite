<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مواد غذائية - سوقني</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="page-header">
        <a href="index.html" class="back-btn">← العودة للرئيسية</a>
        <h2>🍎 مواد غذائية</h2>
        <button class="add-ad-btn" onclick="toggleForm()">➕ إضافة إعلان</button>
    </div>

    <div id="addFormContainer" class="form-container hidden">
        <h2>📝 إضافة إعلان جديد - مواد غذائية</h2>
        <form id="addAdForm">
            <div class="form-group">
                <label>العنوان</label>
                <input type="text" id="adTitle" required placeholder="مثال: عسل طبيعي">
            </div>
            <div class="form-group">
                <label>الوصف</label>
                <textarea id="adDesc" required placeholder="تفاصيل الإعلان..."></textarea>
            </div>
            <div class="form-group">
                <label>السعر (ريال)</label>
                <input type="number" id="adPrice" required placeholder="مثال: 50">
            </div>
            <div class="form-group">
                <label>صورة الإعلان</label>
                <input type="file" id="adImage" accept="image/*">
            </div>
            <button type="submit" class="submit-btn">📤 نشر الإعلان</button>
        </form>
    </div>

    <div class="ads-container">
        <div class="ad-item">
            <img src="https://images.unsplash.com/photo-1587049352851-8d4e8913398d?w=400" alt="طعام">
            <div class="ad-content">
                <h3>عسل طبيعي 100%</h3>
                <p class="desc">عسل سدر، 1 كيلو، انتاج محلي</p>
                <span class="price">120 ريال</span>
            </div>
        </div>
        <div class="ad-item">
            <img src="https://images.unsplash.com/photo-1597362925123-77861d3fbac7?w=400" alt="طعام">
            <div class="ad-content">
                <h3>تمور فاخرة - سكري</h3>
                <p class="desc">علبة 3 كيلو، درجة أولى</p>
                <span class="price">85 ريال</span>
            </div>
        </div>
        <div class="ad-item">
            <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400" alt="طعام">
            <div class="ad-content">
                <h3>زيت زيتون بكر ممتاز</h3>
                <p class="desc">زجاجة 5 لتر، ضمان الجودة</p>
                <span class="price">180 ريال</span>
            </div>
        </div>
    </div>

    <footer><p>© 2026 سوقني - جميع الحقوق محفوظة</p></footer>

    <script src="script.js"></script>
    <script>
        const section = 'مواد غذائية';
        function toggleForm() {
            document.getElementById('addFormContainer').classList.toggle('hidden');
        }
        handleAddAd(section);
    </script>
</body>
</html>
