            </div>

        </a>


        <button
            class="home-btn"
            onclick="goHome()">

            🏠 الرئيسية

        </button>


    </div>

</header>



<!-- =========================
     MAIN
========================= -->

<main>


    <div class="breadcrumb">

        <a href="index.html">
            الرئيسية
        </a>

        <span>
            ← الإعلان
        </span>

    </div>


    <div id="page">

        <div class="loading">

            ⏳ جاري تحميل الإعلان...

        </div>

    </div>


</main>



<!-- =========================
