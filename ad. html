 <!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <!-- سيتم تحديثها من بيانات الإعلان -->
    <meta id="metaDescription"
          name="description"
          content="إعلان على منصة صلة">

    <meta name="theme-color"
          content="#0f766e">

    <title id="pageTitle">
        صلة | الإعلان
    </title>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family:
                Arial,
                Tahoma,
                sans-serif;

            background: #f5f7f8;

            color: #222;

            line-height: 1.8;
        }

        button,
        input {
            font-family: inherit;
        }

        a {
            text-decoration: none;
            color: inherit;
        }


        /* =========================
           HEADER
        ========================== */

        header {
            background: white;

            border-bottom:
                1px solid #e5e7eb;

            position: sticky;

            top: 0;

            z-index: 1000;
        }


        .header-inner {
            max-width: 1100px;

            margin: auto;

            padding:
                10px 16px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;
        }


        .logo {
            display: flex;

            align-items: center;

            gap: 9px;
        }


        .logo-icon {
            width: 43px;

            height: 43px;

            background: #0f766e;

            color: white;

            border-radius: 13px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 24px;

            font-weight: bold;
        }


        .logo-text {
            font-size: 23px;

            font-weight: bold;

            color: #0f766e;
        }


        .logo-subtitle {
            font-size: 10px;

            color: #777;

            margin-top: -6px;
        }


        .home-btn {
            background: #eef7f6;

            color: #0f766e;

            border: none;

            border-radius: 10px;

            padding:
                8px 13px;

            cursor: pointer;

            font-weight: bold;
        }


        /* =========================
           MAIN
        ========================== */

        main {
            max-width: 1050px;

            margin: auto;

            padding:
                25px 15px 50px;
        }


        /* =========================
           BREADCRUMB
        ========================== */

        .breadcrumb {
            color: #777;

            font-size: 13px;

            margin-bottom: 15px;
        }


        .breadcrumb a {
            color: #0f766e;
        }


        /* =========================
           AD BOX
        ========================== */

        .ad-box {
            background: white;

            border-radius: 18px;

            overflow: hidden;

            border:
                1px solid #e5e7eb;

            box-shadow:
                0 5px 20px rgba(0,0,0,.05);
        }


        /* =========================
           IMAGE
        ========================== */

        .image-container {
            width: 100%;

            min-height: 300px;

            background: #eef2f2;

            display: flex;

            align-items: center;

            justify-content: center;
        }


        .main-image {
            display: block;

            width: 100%;

            max-height: 600px;

            object-fit: contain;

            background: #f1f3f3;
        }


        .no-image {
            min-height: 300px;

            width: 100%;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 70px;
        }


        /* =========================
           CONTENT
        ========================== */

        .content {
            padding: 22px;
        }


        .category {
            display: inline-block;

            background: #eef7f6;

            color: #0f766e;

            padding:
                5px 11px;

            border-radius: 8px;

            font-size: 12px;

            margin-bottom: 10px;
        }


        h1 {
            font-size: 30px;

            line-height: 1.5;

            margin-bottom: 10px;
        }


        .price {
            color: #0f766e;

            font-size: 25px;

            font-weight: bold;

            margin:
                8px 0 15px;
        }


        .location {
            color: #666;

            font-size: 14px;

            margin-bottom: 18px;
        }


        .description-title {
            font-size: 19px;

            font-weight: bold;

            margin-bottom: 8px;

            border-bottom:
                1px solid #eee;

            padding-bottom: 8px;
        }


        .description {
            white-space: pre-wrap;

            color: #444;

            font-size: 15px;

            line-height: 2;
        }


        /* =========================
           INFO
        ========================== */

        .info-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 10px;

            margin-top: 22px;
        }


        .info-item {
            background: #f7f9f9;

            border-radius: 10px;

            padding: 10px 12px;

            font-size: 13px;
        }


        .info-label {
            color: #777;

            display: block;

            font-size: 11px;
        }


        .info-value {
            font-weight: bold;

            color: #333;
        }


        /* =========================
           CONTACT
        ========================== */

        .contact-box {
            margin-top: 25px;

            padding-top: 20px;

            border-top:
                1px solid #eee;
        }


        .contact-box h2 {
            font-size: 20px;

            margin-bottom: 12px;
        }


        .contact-buttons {
            display: flex;

            gap: 10px;

            flex-wrap: wrap;
        }


        .contact-btn {
            border: none;

            border-radius: 10px;

            padding:
                11px 18px;

            cursor: pointer;

            font-weight: bold;

            font-size: 14px;
        }


        .back-btn {
            background: #eef7f6;

            color: #0f766e;
        }


        .share-btn {
            background: #333;

            color: white;
        }


        .contact-link {
            background: #0f766e;

            color: white;
        }


        /* =========================
           LOADING
        ========================== */

        .loading {
            text-align: center;

            padding: 80px 20px;

            color: #777;

            font-size: 16px;
        }


        .error {
            background: white;

            border-radius: 15px;

            padding: 50px 20px;

            text-align: center;
        }


        .error-icon {
            font-size: 50px;

            margin-bottom: 10px;
        }


        .error h2 {
            margin-bottom: 8px;
        }


        .error p {
            color: #777;

            margin-bottom: 18px;
        }


        .error a {
            display: inline-block;

            background: #0f766e;

            color: white;

            padding:
                9px 18px;

            border-radius: 9px;
        }


        /* =========================
           FOOTER
        ========================== */

        footer {
            background: #123b39;

            color: white;

            text-align: center;

            padding: 30px 15px;

            margin-top: 30px;
        }


        footer strong {
            font-size: 22px;
        }


        footer p {
            opacity: .8;

            font-size: 12px;

            margin-top: 4px;
        }


        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 600px) {

            main {
                padding:
                    15px 10px 35px;
            }


            .content {
                padding: 17px;
            }


            h1 {
                font-size: 23px;
            }


            .price {
                font-size: 21px;
            }


            .image-container {
                min-height: 230px;
            }


            .no-image {
                min-height: 230px;

                font-size: 55px;
            }


            .info-grid {
                grid-template-columns: 1fr;
            }


            .contact-buttons {
                flex-direction: column;
            }


            .contact-btn {
                width: 100%;
            }

        }

    </style>

</head>


<body>


