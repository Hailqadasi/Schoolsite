========================= -->

<footer>

    <strong>
        صلة
    </strong>

    <p>
        منصة تربط المنتج بالمستهلك
    </p>

    <p>
        جميع الحقوق محفوظة © 2026
    </p>

</footer>



<script>


/* =========================================
   SUPABASE
========================================= */

const SUPABASE_URL =
    "https://yakmcmuzwfhtbrnmpkmd.supabase.co";


const SUPABASE_ANON_KEY =
    "ضع هنا Publishable key الخاص بمشروعك";


const supabaseClient =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_ANON_KEY
    );



/* =========================================
   الحصول على ID الإعلان
========================================= */

const params =
    new URLSearchParams(
        window.location.search
    );


const adId =
    params.get("id");



/* =========================================
   عناصر الصفحة
========================================= */

const page =
    document.getElementById("page");



/* =========================================
   تحميل الإعلان
========================================= */

async function loadAd() {


    if (!adId) {

        showError(
            "الإعلان غير موجود",
            "لم يتم تحديد رقم الإعلان."
        );

        return;

    }


    const {
        data: ad,
        error
    } =
        await supabaseClient

            .from("ads")

            .select("*")

            .eq("id", adId)

            .eq("status", "published")

            .maybeSingle();


    if (error) {

        console.error(
            "Supabase error:",
            error
        );

        showError(
            "تعذر تحميل الإعلان",
            "حدث خطأ أثناء الاتصال بقاعدة البيانات."
        );

        return;

    }


    if (!ad) {

        showError(
            "الإعلان غير موجود",
            "ربما تم حذف الإعلان أو لم يعد منشورًا."
        );

        return;

    }


    renderAd(ad);

}



/* =========================================
   عرض الإعلان
========================================= */

function renderAd(ad) {


    const title =
        ad.title ||
        "إعلان على صلة";


    const description =
        ad.description ||
        "لا توجد تفاصيل إضافية.";


    const category =
        ad.category ||
        "أخرى";


    let price =
        "السعر عند التواصل";


    if (
        ad.price !== null &&
        ad.price !== undefined &&
        ad.price !== ""
    ) {

        price =
            formatNumber(ad.price)
            + " "
            + (ad.currency || "ريال يمني");

    }


    const city =
        ad.city ||
        "غير محدد";


    const sellerName =
        ad.user_name ||
        ad.name ||
        "معلن على صلة";


    const date =
        ad.created_at
            ? formatDate(ad.created_at)
            : "غير محدد";


    /* =========================
       الصورة
    ========================== */

    let imageHTML;


    if (ad.image_url) {

        imageHTML = `

            <img
                class="main-image"
                src="${escapeHtml(ad.image_url)}"
                alt="${escapeHtml(title)}"
            >

        `;

    }

    else if (ad.media_url) {

        imageHTML = `

            <img
                class="main-image"
                src="${escapeHtml(ad.media_url)}"
                alt="${escapeHtml(title)}"
            >

        `;

    }

    else {

        imageHTML = `

            <div class="no-image">
                📦
            </div>

        `;

    }



    /* =========================
       رقم الهاتف
    ========================== */

    const phone =
        ad.phone ||
        ad.contact_phone ||
        ad.seller_phone ||
        "";


    let contactHTML = "";


    if (phone) {

        const cleanPhone =
            String(phone)
                .replace(/\s+/g, "");


        contactHTML += `

            <a
                class="contact-btn contact-link"
                href="tel:${escapeHtml(cleanPhone)}">

                📞 الاتصال بالمعلن

            </a>

        `;

    }


    /* =========================
       واتساب
    ========================== */

    if (phone) {

        let whatsappNumber =
            String(phone)
                .replace(/\D/g, "");


        if (
            whatsappNumber.startsWith("0")
        ) {

            whatsappNumber =
                "967"
                + whatsappNumber.substring(1);

        }


        contactHTML += `

            <a
                class="contact-btn contact-link"
                href="https://wa.me/${whatsappNumber}"
                target="_blank"
                rel="noopener">

                💬 واتساب

            </a>

        `;

    }



    /* =========================
       HTML الصفحة
    ========================== */

    page.innerHTML = `

        <article class="ad-box">


            <div class="image-container">

                ${imageHTML}

            </div>


            <div class="content">


                <div class="category">

                    🏷️
                    ${escapeHtml(category)}

                </div>


                <h1>
                    ${escapeHtml(title)}
                </h1>


                <div
